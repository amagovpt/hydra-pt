# Template de configuracao do udata-hydra.
# Copiar para `config.toml` e preencher os valores reais:
#   cp config.toml.example config.toml
# NAO commitar o config.toml (contem segredos; ja esta no .gitignore).

REDIS_URL="redis://<REDIS_HOST>:6379/0"
API_KEY="<HYDRA_API_KEY>"

CATALOG_URL="https://dados.gov.pt/api/1/datasets/r/<CATALOG_RESOURCE_ID>"

EXCLUDED_PATTERNS = [
    "http%geo.dados.gov.pt%",
    # opendatasoft shp
    "%?format=shp%",
]
# no backoff for those domains
NO_BACKOFF_DOMAINS = [
    "static.dados.gov.pt",
    "dados.gov.pt",
    # dead domain, no need to backoff
    "inspire.dados.gov.pt",
]

CORS_PROBE_ORIGIN = "https://dados.gov.pt"

UDATA_URI="https://<UDATA_HOST>/api/2"
UDATA_URI_API_KEY="<UDATA_API_KEY>"

# TLS verification for the udata callbacks:
#   true           -> verify against the system CA bundle (default)
#   false          -> skip TLS verification (udata behind an internal self-signed cert)
#   "/path/ca.pem" -> verify against this CA/certificate file
UDATA_SSL_VERIFY = false
